# Cluster the app and scripts talk to. The demo uses a local mainnet fork (pnpm demo:fork).
RPC_URL=http://127.0.0.1:28899
PORT_CLUSTER=fork               # fork | localnet | devnet | mainnet-beta

# Pyth Hermes price updates require an API key since 2026-08 (https://pythdata.app).
# Without it every trade fails closed.
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network

# Fork/localnet only: when no Pyth key is set, use labeled fallback prices so the demo can run.
# Ignored on live clusters.
DEV_PRICE_FALLBACK=0

# Optional: Jupiter API key (api.jup.ag) for higher rate limits; lite-api is used otherwise.
JUPITER_API_KEY=

# Optional: mainnet RPC used to build the fork (a private RPC avoids public rate limits).
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Agent executive key file name under .keys/ (created by pnpm demo:fork:prepare). Never commit keys.
EXECUTIVE_KEY_NAME=executive

# Hosted deploys (Vercel) have no .keys/ directory and a read-only repo directory:
# EXECUTIVE_KEY=[1,2,3,...]        # the contents of .keys/executive.json (secret; set only in the host's env)
# ACTIVITY_PATH=/tmp/port/activity.json   # optional override; on Vercel this is the default (ephemeral)
