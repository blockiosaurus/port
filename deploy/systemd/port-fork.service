[Unit]
Description=PORT mainnet fork (solana-test-validator on :28899)
After=network-online.target
Wants=network-online.target

[Service]
User=port
WorkingDirectory=/opt/port
# Regenerated by deploy/reset-fork.sh (pnpm demo:fork:prepare). Starts with --reset, so every
# (re)start is a clean ledger; run reset-fork.sh rather than restarting this unit by hand.
ExecStart=/bin/bash /opt/port/.demo/fork/validator.sh
Environment=PATH=/home/port/.local/share/solana/install/active_release/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5
LimitNOFILE=1000000
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
