{
  "name": "port",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "demo:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-demo.ts",
    "demo:verify": "tsx --env-file-if-exists=.env scripts/verify-demo.ts",
    "localnet": "scripts/localnet.sh",
    "demo:fork:prepare": "tsx --env-file-if-exists=.env scripts/prepare-fork.ts",
    "demo:fork": "bash .demo/fork/validator.sh",
    "test:fork-trade": "tsx --env-file-if-exists=.env scripts/fork-trade.ts",
    "demo:reset": "bash scripts/demo-reset.sh",
    "demo:agent-market": "tsx --env-file-if-exists=.env scripts/launch-agent-market.ts",
    "demo": "bash scripts/demo-all.sh",
    "dev": "pnpm --filter @port/web dev",
    "dev:fork": "RPC_URL=http://127.0.0.1:28899 PORT_CLUSTER=fork pnpm --filter @port/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-agent-registry": "^0.2.6",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/mpl-toolbox": "^0.11.5",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.12",
    "@noble/hashes": "1.8.0",
    "@port/integrations": "workspace:*",
    "@port/port-sdk": "workspace:*",
    "@port/risk-engine": "workspace:*",
    "@port/shared": "workspace:*",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@solana/web3.js": "1",
    "zod": "^4.6.5"
  }
}
